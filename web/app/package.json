{
  "name": "rpg2-page",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "artifact": "ng build && node ../build-artifact.mjs",
    "e2e": "node ../e2e.mjs"
  },
  "prettier": {
